rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The family's uploaded documents (flyers, receipts, PDFs, photos). Everyone signed in can read and
    // remove them; a file is only ever uploaded into its uploader's own folder, with a size and type limit.
    // The addReferenceFile function (Admin SDK) then reads it and writes its /referenceDocs entry.
    match /documents/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|gif)|text/plain');
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
