rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // The household member the requesting account is linked to (see /memberLinks/{uid}),
    // or null if it isn't linked to anyone. Used to gate access to private calendar events.
    function myMemberId() {
      return exists(/databases/$(database)/documents/memberLinks/$(request.auth.uid))
        ? get(/databases/$(database)/documents/memberLinks/$(request.auth.uid)).data.memberId
        : null;
    }

    // App-wide statistics (API counter, etc.)
    match /app-stats/{docId} {
      // Anyone authenticated can read stats
      allow read: if isAuthenticated();
      // Anyone authenticated can increment the counter
      allow update: if isAuthenticated();
      // Only allow creating if it doesn't exist
      allow create: if isAuthenticated();
      // Don't allow deleting stats
      allow delete: if false;
    }
    
    // Todo items collection
    match /todoItems/{todoId} {
      // Anyone authenticated can read all todos
      allow read: if isAuthenticated();
      // Anyone authenticated can create, update, or delete todos
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Grocery / shopping list items
    match /groceryItems/{itemId} {
      // Anyone authenticated can read all grocery items
      allow read: if isAuthenticated();
      // Anyone authenticated can create, update, or delete grocery items
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Reading entries collection
    match /reading-entries/{entryId} {
      // Anyone authenticated can read all reading entries
      allow read: if isAuthenticated();
      // Anyone authenticated can create, update, or delete reading entries
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Remi's recurring schedule settings (single doc)
    match /remi-schedule/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Remi's per-date schedule exceptions (no school, early release, pack lunch, etc.)
    match /remi-schedule-exceptions/{dateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Remi's school lunch menu, keyed by date
    match /remi-lunch-menu/{dateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Auto-fetched raw text of the current month's school lunch menu PDF (written by
    // the syncLunchMenuSource function, read-only from the client)
    match /remi-lunch-menu-source/{monthId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Cached daily briefing for Remi (computed by the dailyRemiBriefing/regenerateBriefing functions)
    match /remi-daily-briefing/{dateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Single household doc holding the family member profiles array
    match /household/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Explicit facts stated by a family member ("Remi is allergic to shellfish")
    match /explicitFacts/{factId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Patterns inferred from the AI suggestion feedback log — written only by the
    // smart-alerts Cloud Function via the Admin SDK, read-only from the client
    match /learnedPatterns/{patternId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Short-term, time-bound context ("grandma visiting Saturday")
    match /recentContext/{contextId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Log of every AI-generated suggestion and its accepted/edited/rejected outcome.
    // Suggestions themselves are created server-side (Admin SDK); the client only
    // updates status when a family member acts on one.
    match /aiSuggestions/{suggestionId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Saved recipes (migrated from device-local storage so they sync across devices and
    // are readable by future meal-suggestion grounding)
    match /recipes/{recipeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Vehicles and their maintenance records (migrated from device-local storage so a
    // nightly smart-alerts job can see mileage/due-date data)
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /maintenanceRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // App-native calendar events (Google Calendar itself stays read-only via OAuth;
    // this is the write path for events created in-app, e.g. via quick-add). A private
    // event (isPrivate: true) is only ever creatable for yourself — never for someone
    // else — so it's only readable/writable by the account linked to its memberId.
    match /calendarEvents/{eventId} {
      // .get(field, default) is required here, not dot access — most events never set
      // isPrivate/memberId at all, and accessing an absent map field directly throws,
      // which would fail-closed and hide every non-private event once this deployed.
      allow read: if isAuthenticated() &&
        (resource.data.get('isPrivate', false) != true || myMemberId() == resource.data.get('memberId', null));
      allow create: if isAuthenticated() &&
        (request.resource.data.get('isPrivate', false) != true || myMemberId() == request.resource.data.get('memberId', null));
      allow update: if isAuthenticated() &&
        (resource.data.get('isPrivate', false) != true || myMemberId() == resource.data.get('memberId', null)) &&
        (request.resource.data.get('isPrivate', false) != true || myMemberId() == request.resource.data.get('memberId', null));
      allow delete: if isAuthenticated() &&
        (resource.data.get('isPrivate', false) != true || myMemberId() == resource.data.get('memberId', null));
    }

    // Links one Firebase Auth account to the household member it belongs to (a
    // self-service "this is me" claim) — a person may only ever read or write their own
    // link, keyed by their own uid, so nobody can claim to be someone else.
    match /memberLinks/{uid} {
      allow read, create, update, delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // User-added quick links (the hardcoded system links never touch Firestore)
    match /quickLinks/{linkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Smart alerts computed by the nightly smart-alerts Cloud Function. Created server-side
    // only; the client will update status (dismissed/acted_on) once a UI exists for that.
    match /smartAlerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Default: deny all access unless explicitly granted above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
